<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>PocketCalculator.Mcp</RootNamespace>
    <AssemblyName>PocketCalculator.Mcp</AssemblyName>
    <Description>PocketCalculator MCP server: browser tools for AI agents over the Model Context Protocol.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- The package depends on PocketCalculator, which carries the engine assemblies;
         Browser is referenced directly to compile against it, and kept out of
         the dependency list because it is not a package. -->
    <ProjectReference Include="../PocketCalculator/PocketCalculator.csproj" />
    <ProjectReference Include="../PocketCalculator.Browser/PocketCalculator.Browser.csproj" PrivateAssets="all" />
  </ItemGroup>
</Project>
