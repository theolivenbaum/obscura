<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>PocketCalculator.Render</RootNamespace>
    <AssemblyName>PocketCalculator.Render</AssemblyName>
    <Description>PocketCalculator rendering: CSS cascade, computed style, layout, and painting onto Skia.</Description>
    <!-- Ships inside the PocketCalculator package, not as a package of its own. -->
    <IsPackable>false</IsPackable>
    <!-- FontAssets.Embedded reads large faces in place from the resource section. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../PocketCalculator.Dom/PocketCalculator.Dom.csproj" />
    <!-- The image agent goes through the SSRF-guarded transport (SECURITY.md). -->
    <ProjectReference Include="../PocketCalculator.Net/PocketCalculator.Net.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.HarfBuzz" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Linux" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.macOS" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Win32" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" />
    <PackageReference Include="SkiaSharp.NativeAssets.macOS" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" />
  </ItemGroup>

  <!-- Font assets, copied from crates/obscura-render/assets/ rather than linked.
       They are byte-identical to the Rust engine's today; re-copy if that tree's
       faces are ever updated, or the two engines will rasterize differently. The
       exception is noto-sans-cjk-sc-regular.otf, the port's own CJK fallback (see
       Assets/FONT-PROVENANCE.md). -->
  <ItemGroup>
    <EmbeddedResource Include="Assets/*.ttf;Assets/*.otf">
      <LogicalName>PocketCalculator.Render.Assets.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
