<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>PocketCalculator.Browser</RootNamespace>
    <AssemblyName>PocketCalculator.Browser</AssemblyName>
    <Description>PocketCalculator browser: pages, navigation, lifecycle, screenshots and PDF export.</Description>
    <!-- Ships inside the PocketCalculator package, not as a package of its own. -->
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../PocketCalculator.Js/PocketCalculator.Js.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" />
  </ItemGroup>
</Project>
