<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>PocketCalculator.Net</RootNamespace>
    <AssemblyName>PocketCalculator.Net</AssemblyName>
    <Description>PocketCalculator networking: HTTP transport, cookies, robots.txt, tracker blocklist and encoding detection.</Description>
    <!-- Ships inside the PocketCalculator package, not as a package of its own. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Tracker blocklist. Copied from crates/obscura-net/src/pgl_domains.txt
       rather than linked, so the C# tree stands on its own. -->
  <ItemGroup>
    <EmbeddedResource Include="Resources/pgl_domains.txt">
      <LogicalName>PocketCalculator.Net.pgl_domains.txt</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- The full Mozilla Public Suffix List (MPL-2.0, license header kept in the file),
       canonical URL https://publicsuffix.org/list/public_suffix_list.dat; this copy is
       the publicsuffix/list repository main branch as of 2026-09-24.
       Refresh it by fetching that URL over the file; nothing else changes. -->
  <ItemGroup>
    <EmbeddedResource Include="Resources/public_suffix_list.dat">
      <LogicalName>PocketCalculator.Net.public_suffix_list.dat</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PocketCalculator.Net.Tests" />
  </ItemGroup>
</Project>
