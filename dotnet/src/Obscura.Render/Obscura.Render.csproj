<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Obscura.Render</RootNamespace>
    <AssemblyName>Obscura.Render</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Obscura.Dom/Obscura.Dom.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.HarfBuzz" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Linux" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.macOS" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Win32" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" />
    <PackageReference Include="SkiaSharp.NativeAssets.macOS" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" />
  </ItemGroup>

  <!-- Font assets are shared with the Rust tree rather than copied, so the two
       engines can never rasterize against different font binaries. -->
  <ItemGroup>
    <EmbeddedResource Include="../../../crates/obscura-render/assets/*.ttf">
      <Link>Assets/%(Filename)%(Extension)</Link>
      <LogicalName>Obscura.Render.Assets.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
