<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>PocketCalculator.Js</RootNamespace>
    <AssemblyName>PocketCalculator.Js</AssemblyName>
    <Description>PocketCalculator JavaScript runtime: V8 through ClearScript, the op layer and the Web API shim.</Description>
    <!-- Ships inside the PocketCalculator package, not as a package of its own. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../PocketCalculator.Dom/PocketCalculator.Dom.csproj" />
    <ProjectReference Include="../PocketCalculator.Net/PocketCalculator.Net.csproj" />
    <ProjectReference Include="../PocketCalculator.Render/PocketCalculator.Render.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ClearScript.V8" />
    <PackageReference Include="Microsoft.ClearScript.V8.Native.linux-x64" />
    <PackageReference Include="Microsoft.ClearScript.V8.Native.linux-arm64" />
    <PackageReference Include="Microsoft.ClearScript.V8.Native.osx-x64" />
    <PackageReference Include="Microsoft.ClearScript.V8.Native.osx-arm64" />
    <PackageReference Include="Microsoft.ClearScript.V8.Native.win-x64" />
  </ItemGroup>

  <!-- The port owns its copy of bootstrap.js. It began as a verbatim copy of
       crates/obscura-js/js/bootstrap.js, which is read-only, so a shim bug could
       not be fixed while the file was linked out of that tree. Carry a fix across
       by hand when it is worth carrying, and note the divergence in todo.md. -->
  <ItemGroup>
    <EmbeddedResource Include="js/bootstrap.js">
      <LogicalName>PocketCalculator.Js.bootstrap.js</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
