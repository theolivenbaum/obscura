<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Obscura.Cli</RootNamespace>
    <!-- The assembly cannot be named "obscura": NuGet resolves project identity
         case-insensitively by assembly name and would collide with the Obscura
         library project. The launcher below still produces an `obscura` binary
         so CLI invocations match the Rust build. -->
    <AssemblyName>Obscura.Cli</AssemblyName>
  </PropertyGroup>

  <!-- Cold start is dominated by JIT: on a trivial page the port spends about
       790 ms before it prints, against about 40 ms for the Rust binary, and
       roughly 300 ms of that is jitting the DOM, style, layout and paint stack
       on the way to the first frame. Precompiling to native images removes it.
       Measured on the same page and host, best of five:

         plain publish                        790 ms
         PublishReadyToRun                    480 ms
         + composite, self-contained          360 ms

       Composite requires self-contained, so it turns itself on only when the
       publish already is. Both need a RuntimeIdentifier; without one the SDK
       fails the build rather than quietly skipping, hence the condition. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishReadyToRunComposite Condition="'$(SelfContained)' == 'true'">true</PublishReadyToRunComposite>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Obscura/Obscura.csproj" />
    <ProjectReference Include="../Obscura.Js/Obscura.Js.csproj" />
    <ProjectReference Include="../Obscura.Render/Obscura.Render.csproj" />
    <ProjectReference Include="../Obscura.Cdp/Obscura.Cdp.csproj" />
    <ProjectReference Include="../Obscura.Mcp/Obscura.Mcp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <!-- Emit `obscura` (and `obscura-worker`) next to the apphost so the CLI is
       invoked exactly as the Rust binary is. -->
  <Target Name="CopyObscuraLauncher" AfterTargets="Build"
          Condition="'$(OS)' != 'Windows_NT'">
    <Copy SourceFiles="$(TargetDir)$(AssemblyName)" DestinationFiles="$(TargetDir)obscura"
          Condition="Exists('$(TargetDir)$(AssemblyName)')" />
    <Exec Command="chmod +x &quot;$(TargetDir)obscura&quot;" Condition="Exists('$(TargetDir)obscura')" />
    <!-- The apphost embeds the managed entry assembly's name, so a renamed copy
         still runs Obscura.Cli.dll; WorkerHost selects worker mode from the
         launcher's own file name, exactly matching the Rust build's two-binary
         layout that `scrape`'s sibling lookup depends on. -->
    <Copy SourceFiles="$(TargetDir)$(AssemblyName)" DestinationFiles="$(TargetDir)obscura-worker"
          Condition="Exists('$(TargetDir)$(AssemblyName)')" />
    <Exec Command="chmod +x &quot;$(TargetDir)obscura-worker&quot;" Condition="Exists('$(TargetDir)obscura-worker')" />
  </Target>

  <!-- The same two launchers in the publish directory. `scrape` finds its worker
       as a sibling of the running binary, so a publish without them fails at
       run time, not at build time. -->
  <Target Name="CopyObscuraLauncherOnPublish" AfterTargets="Publish"
          Condition="'$(OS)' != 'Windows_NT'">
    <Copy SourceFiles="$(PublishDir)$(AssemblyName)" DestinationFiles="$(PublishDir)obscura"
          Condition="Exists('$(PublishDir)$(AssemblyName)')" />
    <Exec Command="chmod +x &quot;$(PublishDir)obscura&quot;" Condition="Exists('$(PublishDir)obscura')" />
    <Copy SourceFiles="$(PublishDir)$(AssemblyName)" DestinationFiles="$(PublishDir)obscura-worker"
          Condition="Exists('$(PublishDir)$(AssemblyName)')" />
    <Exec Command="chmod +x &quot;$(PublishDir)obscura-worker&quot;" Condition="Exists('$(PublishDir)obscura-worker')" />
  </Target>

</Project>
