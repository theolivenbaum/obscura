<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Obscura.Cdp</RootNamespace>
    <AssemblyName>Obscura.Cdp</AssemblyName>
    <Description>Obscura Chrome DevTools Protocol server, for driving the engine with Puppeteer or Playwright.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- The package depends on Obscura, which carries the engine assemblies;
         Browser is referenced directly to compile against it, and kept out of
         the dependency list because it is not a package. -->
    <ProjectReference Include="../Obscura/Obscura.csproj" />
    <ProjectReference Include="../Obscura.Browser/Obscura.Browser.csproj" PrivateAssets="all" />
  </ItemGroup>
</Project>
