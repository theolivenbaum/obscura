<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>PocketCalculator.Cli.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/PocketCalculator.Cli/PocketCalculator.Cli.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The screenshot tests decode the CLI's PNG the way the Rust test does
         with the `image` crate; SkiaSharp is already on the CLI's transitive
         graph through PocketCalculator.Render, so this adds no new dependency. -->
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
  </ItemGroup>

</Project>
